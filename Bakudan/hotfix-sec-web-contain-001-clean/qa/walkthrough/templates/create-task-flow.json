{
  "name": "Create Task Flow",
  "description": "Navigate to project, create a task, verify it appears",
  "steps": [
    { "action": "goto", "url": "/login", "description": "Navigate to login" },
    { "action": "fill", "selector": "input[name='email']", "value": "admin@bakudanramen.com", "description": "Enter email" },
    { "action": "fill", "selector": "input[name='password']", "value": "admin123", "description": "Enter password" },
    { "action": "click", "selector": "button[type='submit']", "description": "Login" },
    { "action": "wait", "pattern": "/(dashboard|overview|my-tasks)", "description": "Wait for dashboard" },
    { "action": "goto", "url": "/projects", "description": "Navigate to projects" },
    { "action": "screenshot", "description": "Projects page loaded" },
    { "action": "goto", "url": "/my-tasks", "description": "Navigate to my tasks" },
    { "action": "screenshot", "description": "My tasks page loaded" }
  ]
}
