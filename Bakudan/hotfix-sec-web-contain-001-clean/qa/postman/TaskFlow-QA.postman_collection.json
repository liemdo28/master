                  "pm.test('user object returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('role');",
                  "    pm.expect(json).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/me",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Verify token is valid and returns authenticated user details."
          },
          "response": []
        }
