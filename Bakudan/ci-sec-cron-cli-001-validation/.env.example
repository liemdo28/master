# Database
DB_HOST=mysql-taskflow.bakudanramen.com
DB_NAME=taskflow_db
DB_USER=liemdo
DB_PASS=your_password_here
DB_CHARSET=utf8mb4

# App
APP_NAME=TaskFlow
APP_URL=https://dashboard.bakudanramen.com
APP_VERSION=2.3.0

# Optional: read-only QuickBooks agent SQLite snapshot for /admin/data-freshness.
# Leave unset on hosted production until the file is mounted or synced securely.
QB_AGENT_DB_PATH=
QB_MIRROR_DB_PATH=

# Phase 14: Credential Vault Encryption
# REQUIRED: Generate a strong random key (e.g.: openssl rand -hex 32)
# This key encrypts all stored passwords using AES-256-GCM.
# NEVER commit the real key to git. Rotate this key carefully — all passwords must be re-encrypted.
CREDENTIAL_ENCRYPTION_KEY=your_strong_random_key_here_min_32_chars
