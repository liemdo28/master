# ── Google OAuth (run scripts/reauth.mjs once to get these) ──────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ACCOUNT_ID=your_google_account_id

# ── Location IDs (run scripts/test-connection.mjs to discover them) ──────────
GOOGLE_LOCATION_ID_RAW_SUSHI_STOCKTON=
GOOGLE_LOCATION_ID_BAKUDAN_BANDERA=
GOOGLE_LOCATION_ID_BAKUDAN_RIM=
GOOGLE_LOCATION_ID_BAKUDAN_STONE_OAK=

# ── Email notifications for 1-3★ reviews ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_FROM=Review Bot <your_gmail@gmail.com>
NOTIFY_CC=
REMINDER_DAYS=2

# Per-location manager emails (comma-separated for multiple)
MANAGER_EMAIL_RAW_SUSHI_STOCKTON=
MANAGER_EMAIL_BAKUDAN_BANDERA=
MANAGER_EMAIL_BAKUDAN_RIM=
MANAGER_EMAIL_BAKUDAN_STONE_OAK=
