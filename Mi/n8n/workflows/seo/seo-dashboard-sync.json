{
  "workflow_id": "seo-dashboard-sync",
  "name": "SEO Dashboard Sync",
  "domain": "seo",
  "trigger_type": "schedule",
  "source": "n8n",
  "mi_required": true,
  "approval_required": false,
  "brand_id": "all",
  "location_id": "all",
  "schedule": "0 6 * * *",
  "schedule_tz": "Asia/Ho_Chi_Minh",
  "description": "Syncs all SEO data to the central dashboard. Data aggregation and ranking done in Mi-Core.",
  "actions": [
    {"order": 1, "type": "http_request", "name": "intake_event", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/intake/event", "body": {"source": "n8n", "domain": "seo", "event_type": "seo_dashboard_sync_request", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "started_at": "{{started_at}}"}},
    {"order": 2, "type": "http_request", "name": "trigger_mi_core", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/tasks/dispatch", "body": {"domain": "seo", "action": "dashboard_sync", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}"}},
    {"order": 3, "type": "http_request", "name": "log_result", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/workflows/log", "body": {"workflow_id": "seo-dashboard-sync", "domain": "seo", "source": "n8n", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "status": "{{trigger_mi_core.status}}", "started_at": "{{started_at}}", "completed_at": "{{completed_at}}", "error": ""}}
  ]
}
