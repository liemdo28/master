{
  "workflow_id": "seo-content-opportunity-scan",
  "name": "SEO Content Opportunity Scan",
  "domain": "seo",
  "trigger_type": "schedule",
  "source": "n8n",
  "mi_required": true,
  "approval_required": true,
  "brand_id": "all",
  "location_id": "all",
  "schedule": "0 10 * * 3",
  "schedule_tz": "Asia/Ho_Chi_Minh",
  "description": "Scans content opportunities based on keyword gaps and competitor analysis. Scoring done in Mi-Core.",
  "actions": [
    {"order": 1, "type": "http_request", "name": "intake_event", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/intake/event", "body": {"source": "n8n", "domain": "seo", "event_type": "seo_opportunity_scan_request", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "started_at": "{{started_at}}"}},
    {"order": 2, "type": "http_request", "name": "decision_request", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/decision/request", "body": {"workflow_id": "seo-content-opportunity-scan", "domain": "seo", "action": "content_opportunity_scan", "brand_id": "{{brand_id}}", "decision_needed": "approve_content_opportunity_execution"}},
    {"order": 3, "type": "condition", "name": "check_approval", "condition": "{{decision_request.response.approved}} === true"},
    {"order": 4, "type": "http_request", "name": "trigger_mi_core", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/tasks/dispatch", "body": {"domain": "seo", "action": "content_opportunity_scan", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}"}},
    {"order": 5, "type": "http_request", "name": "log_result", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/workflows/log", "body": {"workflow_id": "seo-content-opportunity-scan", "domain": "seo", "source": "n8n", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "status": "{{trigger_mi_core.status}}", "started_at": "{{started_at}}", "completed_at": "{{completed_at}}", "error": ""}}
  ]
}
