{
  "workflow_id": "career-outreach-sequence",
  "name": "Career Outreach Sequence",
  "domain": "career",
  "trigger_type": "schedule",
  "source": "n8n",
  "mi_required": true,
  "approval_required": true,
  "brand_id": "personal",
  "location_id": "all",
  "schedule": "0 9 * * 1-5",
  "schedule_tz": "Asia/Ho_Chi_Minh",
  "description": "Career outreach sequence for candidate outreach. Approval required before sending.",
  "actions": [
    {"order": 1, "type": "http_request", "name": "intake_event", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/intake/event", "body": {"source": "n8n", "domain": "career", "event_type": "career_outreach_request", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "started_at": "{{started_at}}"}},
    {"order": 2, "type": "http_request", "name": "decision_request", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/decision/request", "body": {"workflow_id": "career-outreach-sequence", "domain": "career", "action": "outreach_sequence", "brand_id": "{{brand_id}}", "decision_needed": "approve_career_outreach"}},
    {"order": 3, "type": "condition", "name": "check_approval", "condition": "{{decision_request.response.approved}} === true"},
    {"order": 4, "type": "http_request", "name": "trigger_mi_core", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/tasks/dispatch", "body": {"domain": "career", "action": "outreach_sequence", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}"}},
    {"order": 5, "type": "http_request", "name": "log_result", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/workflows/log", "body": {"workflow_id": "career-outreach-sequence", "domain": "career", "source": "n8n", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "status": "{{trigger_mi_core.status}}", "started_at": "{{started_at}}", "completed_at": "{{completed_at}}", "error": ""}}
  ]
}
