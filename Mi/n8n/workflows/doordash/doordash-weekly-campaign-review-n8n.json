{
  "name": "doordash-weekly-campaign-review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1"
            }
          ]
        }
      },
      "id": "doordash_0",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/intake/event",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"n8n\",\n  \"domain\": \"doordash\",\n  \"event_type\": \"doordash_weekly_review_request\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\",\n  \"started_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "doordash_1",
      "name": "Intake Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/tasks/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domain\": \"doordash\",\n  \"action\": \"weekly_campaign_review\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "doordash_2",
      "name": "Trigger DoorDash Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/approval/request",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"doordash-weekly-campaign-review\",\n  \"domain\": \"doordash\",\n  \"action\": \"apply_campaign_changes\",\n  \"brand_id\": \"all\",\n  \"decision_needed\": \"approve_campaign_changes\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "doordash_3",
      "name": "Approval For Changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/workflows/log",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"doordash-weekly-campaign-review\",\n  \"domain\": \"doordash\",\n  \"source\": \"n8n\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\",\n  \"status\": \"completed\",\n  \"started_at\": \"{{ $now.toISO() }}\",\n  \"completed_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "doordash_4",
      "name": "Log Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Intake Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Intake Event": {
      "main": [
        [
          {
            "node": "Trigger DoorDash Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger DoorDash Agent": {
      "main": [
        [
          {
            "node": "Approval For Changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approval For Changes": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 300
  }
}
