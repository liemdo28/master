{
  "name": "food-safety-daily-reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "food_safety_0",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/intake/event",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"n8n\",\n  \"domain\": \"food-safety\",\n  \"event_type\": \"food_safety_reminder_request\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\",\n  \"started_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "food_safety_1",
      "name": "Intake Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/tasks/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domain\": \"food-safety\",\n  \"action\": \"get_reminder_stores\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "food_safety_2",
      "name": "Get Stores Needing Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/approval/request",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"food-safety-daily-reminder\",\n  \"domain\": \"food-safety\",\n  \"action\": \"send_whatsapp_reminder\",\n  \"brand_id\": \"all\",\n  \"decision_needed\": \"approve_whatsapp_reminder\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "food_safety_3",
      "name": "Approval For WhatsApp Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.approved }}",
              "value2": true
            }
          ]
        },
        "options": {}
      },
      "id": "food_safety_4",
      "name": "Check Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4001/api/mi/workflows/log",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"food-safety-daily-reminder\",\n  \"domain\": \"food-safety\",\n  \"source\": \"n8n\",\n  \"brand_id\": \"all\",\n  \"location_id\": \"all\",\n  \"status\": \"completed\",\n  \"started_at\": \"{{ $now.toISO() }}\",\n  \"completed_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "food_safety_5",
      "name": "Log Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Intake Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Intake Event": {
      "main": [
        [
          {
            "node": "Get Stores Needing Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Stores Needing Reminders": {
      "main": [
        [
          {
            "node": "Approval For WhatsApp Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approval For WhatsApp Send": {
      "main": [
        [
          {
            "node": "Check Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Approved": {
      "main": [
        [
          {
            "node": "Log Delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 120
  }
}
