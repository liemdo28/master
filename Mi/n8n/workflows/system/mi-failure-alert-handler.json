{
  "workflow_id": "mi-failure-alert-handler",
  "name": "Mi Failure Alert Handler",
  "domain": "system",
  "trigger_type": "webhook",
  "source": "n8n",
  "mi_required": true,
  "approval_required": false,
  "brand_id": "all",
  "location_id": "all",
  "schedule": null,
  "description": "Handles failure alerts routed from Mi-Core. Escalates to IT/executive coordination.",
  "actions": [
    {"order": 1, "type": "http_request", "name": "intake_event", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/intake/event", "body": {"source": "n8n", "domain": "system", "event_type": "failure_alert_received", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "started_at": "{{started_at}}"}},
    {"order": 2, "type": "http_request", "name": "route_failure", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/workflows/dead-letter", "body": {"workflow_id": "mi-failure-alert-handler", "domain": "system", "source": "n8n", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "escalate": true}},
    {"order": 3, "type": "http_request", "name": "log_result", "method": "POST", "url": "{{MI_CORE_URL}}/api/mi/workflows/log", "body": {"workflow_id": "mi-failure-alert-handler", "domain": "system", "source": "n8n", "brand_id": "{{brand_id}}", "location_id": "{{location_id}}", "status": "completed", "started_at": "{{started_at}}", "completed_at": "{{completed_at}}", "error": ""}}
  ]
}
